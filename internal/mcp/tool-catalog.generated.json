    {
      "name": "apply_patch",
      "description": "Download and apply a patch to the project",
      "input_schema": {
        "type": "object",
        "properties": {
          "composer_package": {
            "type": "string",
            "description": "Package the patch belongs to, e.g. drupal/devel. Required for module and theme patches so paths resolve from the package root"
          },
          "description": {
            "type": "string",
            "description": "Patch description recorded in composer.json extra.patches"
          },
          "patch_url": {
            "type": "string",
            "description": "URL of the patch file, or a path inside the project"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path to the Drupal project"
          },
          "request_id": {
            "type": "string",
            "description": "Stable client-generated ID used to deduplicate this mutation"
          },
          "run_id": {
            "type": "string",
            "description": "Persisted upgrade run ID authorizing this mutation"
          }
        },
        "required": [
          "patch_url",
          "project_path",
          "composer_package",
          "description",
          "request_id",
          "run_id"
        ]
      },
      "effect": "mutating",
      "role": "executor",
      "preconditions": [
        "session",
        "backup",
        "mutation_cap"
      ],
      "stub": true,
      "session_policy": "refuse",
      "requires_run": true,
      "retry_eligible": false
    },
