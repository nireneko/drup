    {
      "name": "checkpoint_execute",
      "description": "Execute and persist a deterministic operational checkpoint: backup, package update, database updates, cache rebuild, status, independent validation, and managed configuration export. It never publishes a commit; checkpoint_commit remains the only publication boundary",
      "input_schema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "description": "Complete candidate paths whose identity is recomputed after validation"
          },
          "phase": {
            "type": "string",
            "description": "Active run phase: custom_theme, contrib_patch, contrib_minor, contrib_major, core_loop, or cleanup"
          },
          "project_path": {
            "type": "string",
            "description": "Absolute path to the Drupal project"
          },
          "request_id": {
            "type": "string",
            "description": "Stable client-generated ID used to deduplicate this mutation"
          },
          "resume": {
            "type": "boolean",
            "description": "Explicitly retry only a previously unavailable step; requires a fresh request_id"
          },
          "run_id": {
            "type": "string",
            "description": "Persisted upgrade run ID authorizing this mutation"
          },
          "target_major": {
            "type": "integer",
            "description": "Must exactly match the run target major"
          },
          "targets": {
            "type": "array",
            "description": "Composer/package targets; contrib_major accepts exactly one"
          }
        },
        "required": [
          "project_path",
          "run_id",
          "phase",
          "target_major",
          "targets",
          "paths",
          "request_id"
        ]
